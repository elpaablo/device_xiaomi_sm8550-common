# MiuiCamera runs mialgo/SNPE inference in-process on the CDSP.
# Gated by target_has_miuicamera in the sm8550 DSP neverallows.
allow platform_app vendor_xdsp_device:chr_file r_file_perms;

get_prop(platform_app, vendor_audio_prop)
get_prop(platform_app, vendor_camera_sensor_prop)

# MiuiCamera's in-process AI vision searches /vendor/dsp for its skels.
# Only the directory: coredomains are neverallowed any access to a
# vendor_file_type file that is not same_process_hal_file.
allow platform_app adsprpcd_file:dir r_dir_perms;
